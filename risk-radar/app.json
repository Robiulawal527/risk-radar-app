{
  "expo": {
    "name": "Risk Radar",
    "slug": "risk-radar",
    "scheme": "riskradar",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro"
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "ios": {
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Risk Radar uses your location to show nearby risk zones."
      }
    },
    "plugins": [
      "expo-router"
    ]
  }
}
